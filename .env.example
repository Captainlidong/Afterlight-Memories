# 运行模式：demo（默认，无需任何 API Key）| ai（需配置下方 AI_* 字段）
# demo：自有照片走本地确定性规则，示例照片命中内置预设；全程零外部调用。
# ai：四个策展阶段通过统一服务端客户端调用外部模型（openai-compatible 协议）。
#     创建影展时可在页面单独选择模式；未配置或未授权时服务端拒绝外发，演示模式不受影响。
AFTERLIGHT_MODE=demo

# 访问模式：local（默认，本机单人）| public（公网多人，需完成作品权限与 IP/用户限流后方可开放）
AFTERLIGHT_ACCESS_MODE=local

# 运行时数据目录（SQLite 数据库 + 上传原图/缩略图），相对项目根目录
AFTERLIGHT_DATA_DIR=./data

# 开发服务端口（冲突时可改：npm run dev -- -p 3001）
PORT=3000

# ---------------- 真实 AI 模型服务（v3，可选；不填则 AI 模式不可用） ----------------
# 初版只支持 OpenAI 兼容协议（AI_PROVIDER 固定 openai-compatible）。
# 接口地址写服务商控制台给的 Base URL（通常以 /v1 结尾；尾斜杠会被归一化，
# 程序固定拼接 /chat/completions，不要重复写接口路径）。非本地服务必须 HTTPS。
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
# 视觉与文本模型 ID。AI_TEXT_MODEL 留空时复用 AI_VISION_MODEL，不猜测模型名。
AI_VISION_MODEL=
AI_TEXT_MODEL=
# DeepSeek 官方本地接入：AI_BASE_URL=https://api.deepseek.com
# 视觉与文本均可填 deepseek-flash；官方接口自动使用非思考模式，详见 docs/ai-setup.md §3.1。
# 不把 Key 发进聊天；不需要登录或每用户限额；真实联调需先确认照片与总调用数。

# 图片预处理：按 EXIF 转正后限制长边（像素），不放大原图
AI_IMAGE_MAX_EDGE=1280
# 单次策展任务最多分析的照片数（超出在接任务前拒绝，不静默截断）
AI_MAX_PHOTOS_PER_JOB=30
# 同时外发的最大请求数
AI_MAX_CONCURRENCY=2
# 单次请求超时（毫秒）
AI_REQUEST_TIMEOUT_MS=60000
# 瞬态错误（429 限流/5xx）与格式修复的合计追加次数上限
AI_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=2500
# 预算上限（调用次数，非金额）：每次真实外发（含重试、连接测试）都计数。
# 服务商侧请同时在控制台配置余额/额度限制。
# 同一影展所有 AI workflow 共用持久总额；首次冻结，跨日/重试/调高配置不重置。
# 调低配置可收紧额度；暂无重置/新轮次入口。连接探测另计日额与小时额。
AI_MAX_CALLS_PER_JOB=40
# 所有请求（含连接探测）共用的每日额度；仅日额按时区重置。
AI_MAX_CALLS_PER_DAY=100
# 连接测试独立频率（小时），页面轮询/加载不消耗任何额度
AI_CONNECTION_TEST_LIMIT_PER_HOUR=5
AI_DAY_TIMEZONE=Asia/Shanghai
# 结果缓存：相同输入+版本命中缓存不再外发；换模型/提示词/预处理版本自动失效
AI_CACHE_ENABLED=true

# ---------------- 公开访问限流（仅 AFTERLIGHT_ACCESS_MODE=public 时生效） ----------------
# public 模式要求 RATE_LIMIT_ENABLED=true；未完成作品访问权限与限流前不要开放公网。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TASKS_PER_IP_PER_MINUTE=2
RATE_LIMIT_TASKS_PER_IP_PER_DAY=5
RATE_LIMIT_TASKS_PER_USER_PER_DAY=5

# 说明：
# - 密钥只从服务端环境读取，绝不使用 NEXT_PUBLIC_* 前缀，也不写入前端/日志/导出文件。
# - 配置填写到 .env.local（不进入版本控制）。修改后重启生效：
#   dev：Ctrl+C 后重新 npm run dev；生产：npm run build 后 npm start。
# - 部署到平台时使用平台的服务端环境变量/密钥配置。
